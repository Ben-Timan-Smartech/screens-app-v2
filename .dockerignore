# Things we don't want in the container build context.
# Same spirit as .gitignore but specifically for Cloud Build / docker build:
# excluding everything below keeps the build context small and fast.

# The Android player source — irrelevant to the backend container
player/

# Build / IDE / OS noise
.git/
.gradle/
.idea/
.vscode/
.claude/
build/
captures/
.externalNativeBuild/
.cxx/

# Python
__pycache__/
*.pyc
*.pyo
*.venv/
venv/

# Generated by scan-videos.py — rebuilt on demand
library.json
real-data.jsx
app/components/real-data.jsx
app/components/library.json

# OS / IDE files
.DS_Store
Thumbs.db
desktop.ini

# Local-only config
local.properties
keystore.properties

# Anything that lived in the repo top-level scaffold from before the cleanup
gradlew
gradlew.bat
build.gradle.kts
settings.gradle.kts
gradle.properties
gradle/

# Internal docs not needed at runtime
*.md
!README.md
design-source/
