<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for InstallAutoConfirmService — the accessibility service that presses
  INSTALL on the system update dialog so an unattended screen updates itself.

  No `android:packageNames` filter is set on purpose: cheap retail boxes ship a
  grab-bag of installer packages (AOSP, Google, OEM forks), and a fixed allow-
  list would silently miss some. Instead the service receives window events from
  everywhere and filters to installer packages in code — and only acts at all
  while the updater has armed it (see InstallAutoConfirm.isExpecting), so the
  broad event scope is never used for anything but confirming our own update.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/auto_confirm_desc"
    android:notificationTimeout="100" />
