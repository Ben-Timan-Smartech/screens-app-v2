# ─────────────────────────────────────────────────────────────
# Screens App V2 — .gitignore
#
# Strategy: only commit source code + brand assets the system needs
# at runtime. Everything else (build artefacts, IDE state, generated
# data, secrets, design source files) stays out.
# ─────────────────────────────────────────────────────────────

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/
.claude/

# Android / Gradle build output
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/

# Local SDK + machine-specific Gradle config — never ship these
local.properties
keystore.properties

# Real Firebase config — only the .example file is committed
google-services.json

# Generated by scan-videos.py — rebuilt from the Drive mount on demand
library.json
real-data.jsx
app/components/real-data.jsx

# Built APKs (rebuilt from source)
*.apk
*.aab

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Local persistence files. Cloud Run mounts /data/users.json from a
# Cloud Storage volume; nothing data-shaped should ever be committed.
screens.db
screens.db-wal
screens.db-shm
users.json
users.json.tmp

# Node (in case anyone adds a CMS build step)
node_modules/
*.log
.npm/
.yarn/

# Top-level dead Gradle scaffolding — superseded by player/ having its own
/build.gradle.kts
/settings.gradle.kts
/gradle.properties
/gradlew
/gradlew.bat
/gradle/

# Stuff that isn't part of the system
/Screens/
/screens-cms/
/design-source/
/files.zip
/01-design-brief.md
/02-engineering-brief.md
/demo-script.md
